# Frontend (safe to expose client-side — security is enforced by RLS, not by hiding these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only used by scripts/migrate-seed.mjs, run locally/server-side. NEVER prefix with VITE_
# or ship this to the browser — it bypasses Row Level Security entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
